NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/digital_heroes?replicaSet=rs0
CLIENT_ORIGIN=http://localhost:5173
DB_TIMEOUT_MS=3000
SHUTDOWN_TIMEOUT_MS=10000
# Keep 0 locally; 1 only behind the documented single trusted reverse proxy.
TRUST_PROXY=0
AUTH_SECRET=replace-with-a-random-secret-of-at-least-32-characters
# Demo funding assumption, leaves a maximum 50% charity contribution.
PRIZE_PERCENT=50
PAYMENT_MODE=simulated
CURRENCY=GBP
# Explicit demo assumptions; amounts are minor units (pence for GBP).
MONTHLY_PRICE_MINOR=1900
YEARLY_PRICE_MINOR=19000


# Evidence/media storage. Local stores validated images privately in MongoDB, not Cloudinary.
PROOF_STORAGE=local
# Required only with PROOF_STORAGE=cloudinary. Never expose these to Vite.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
